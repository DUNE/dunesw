#include "wirecell_dune.fcl"

#include "services_dune.fcl"
#include "PDHDFEMBFilter.fcl"
#include "spacecharge_dune.fcl"

process_name: wirecellimaging

services:
{
  # Load the service that manages root files for histograms.
  TimeTracker:       @local::dune_time_tracker
  MemoryTracker:     @local::dune_memory_tracker
  RandomNumberGenerator: {} #ART native random number generator
  message:              @local::dune_message_services_prod
  FileCatalogMetadata:  @local::art_file_catalog_data
  ChannelStatusService: @local::dunefd_channel_status
  WireReadout:          @local::dune_wire_readout
  GeometryConfigurationWriter:  {}
  Geometry:                     @local::protodunehd_geo
  AuxDetGeometry:               @local::protodunehd_auxdet_geo
  DetectorClocksService:        @local::protodunehd_detectorclocks
  DetectorPropertiesService:    @local::protodunehd_detproperties_resampled
  LArPropertiesService:         @local::dunefd_properties
  LArFFT:                       @local::dunefd_larfft
  DatabaseUtil:                 @local::dunefd_database
  BackTrackerService:           @local::pdsp_backtrackerservice
  ParticleInventoryService:     @local::dunefd_particleinventoryservice
  PhotonBackTrackerService:     @local::dunefd_photonbacktrackerservice_legacy
  SpaceCharge:                  @local::pdhd_spacecharge


  IFBeam: {}

  TFileService:
  {
    fileName: "pdhd_keepup_decoder.root"
  }
  HDF5RawFile3Service:  {}

  DAPHNEChannelMapService: {
    FileName: "DAPHNE_test5_ChannelMap_v1.txt"
  }

  PD2HDChannelMapService:
   {
     FileName: "PD2HDChannelMap_WIBEth_visiblewires_v1.txt"
   }
}

physics:
{

  filters: {
    fembfilter: @local::pdhdfembfilter
  }

  producers:
  {
    # Imaging
    # See dunereco/DUNEWireCell/wirecell_dune.fcl
    wclsimaging:         @local::protodunehd_img_nfsp_input_mc
  }

  produce: [
    fembfilter,
    wclsimaging
  ]

  output: [ out1 ]
  trigger_paths : [ produce ]
  end_paths: [ ] # We don't write anything out from imaging -- contingent on changes to jsonnets!!
}

outputs:
{
  out1:
  {
    outputCommands: [ "keep *", "drop *_reco3d_noreg_*",
                     "drop *_reco3d_pre_*"]
    compressionLevel: 1
    module_type: RootOutput
    fileName: "%ifb_%tc_wcimaging.root"
    dataTier:    "full-reconstructed"
    streamName: "out1"
  }
}