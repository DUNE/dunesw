#include "standard_g4_dune10kt.fcl"

services: {
    @table::services
    @table::dunefd_1x2x6_simulation_services
}

# swap to 1x2x6 pdfastsim configuration and remove split Center/Ends configurations
PDFastSimCenter: @erase
PDFastSimEnds: @erase

physics.producers.PDFastSim: @local::dunefd_1x2x6_pdfastsim
physics.simulate: [ rns, largeant, IonAndScint, PDFastSim ]